# Frontend Auth0 settings.
# These values come from the Auth0 dashboard and are read only by the React app.
# The backend must also be configured separately with dotnet user-secrets.
VITE_AUTH0_DOMAIN=your-tenant.region.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://climbing-logbook-api
VITE_API_BASE_URL=http://localhost:5050
